APP_ENV=production
APP_BASE_URL=https://your-domain.example
APP_DOMAIN=your-domain.example
RELEASE_TAG=local
POSTGRES_PASSWORD=replace-with-generated-value
API_DB_PASSWORD=replace-with-generated-value
DATABASE_URL=postgresql+psycopg://insta_api:replace-with-generated-value@db:5432/insta
WORKER_DATABASE_URL=postgresql+psycopg://insta_worker:replace-with-generated-value@db:5432/insta
REDIS_URL=redis://redis:6379/0
AUTH_VAULT_URL=redis://auth-vault:6379/0
CSRF_SECRET=replace-with-generated-value
INSTAGRAM_PENDING_ENCRYPTION_KEY=replace-with-generated-fernet-key
INSTAGRAM_SESSION_ENCRYPTION_KEY=replace-with-generated-fernet-key
SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECURE=true
INSTAGRAM_PRIVATE_ENABLED=true
INSTAGRAM_SYNC_INTERVAL_HOURS=24
INSTAGRAM_MANUAL_MIN_INTERVAL_HOURS=6
INSTAGRAM_MAX_RUNS_PER_24H=2
INSTAGRAM_REQUEST_BUDGET=100
INSTAGRAM_REQUEST_SPACING_SECONDS=2
INSTAGRAM_PLATFORM_COOLDOWN_HOURS=0
INSTAGRAM_CREDENTIAL_TTL_SECONDS=600
MAX_PROFILES_PER_USER=1
MAX_UPLOAD_BYTES=104857600
MAX_UNPACKED_BYTES=524288000
MAX_ARCHIVE_ENTRIES=5000
MAX_SNAPSHOT_MEMBERS=100000
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_TLS_MODE=starttls
MAIL_FROM=InstaSurveillance <hello@your-domain.example>
S3_ENDPOINT=https://private-s3.your-provider.example
S3_REGION=us-east-1
S3_BUCKET=insta-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-with-generated-value
TRUSTED_HOSTS=your-domain.example,localhost,127.0.0.1,backend
STORAGE_BACKEND=s3
STORAGE_DIRECTORY=/uploads
MIGRATION_DATABASE_URL=postgresql+psycopg://insta:replace-with-generated-value@db:5432/insta
WORKER_DB_PASSWORD=replace-with-generated-value
ENCRYPTION_KEY=replace-with-generated-fernet-key
METRICS_TOKEN=replace-with-generated-value
INSTAGRAM_SESSION_KEY_VERSION=1
INSTAGRAM_SESSION_PREVIOUS_KEYS={}
LEDGER_DIRECTORY=/ledger
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_JURISDICTION=
SUPPORT_EMAIL=
LEDGER_S3_BUCKET=
LEDGER_S3_ENDPOINT=
LEDGER_S3_ACCESS_KEY_ID=
LEDGER_S3_SECRET_ACCESS_KEY=
USER_STORAGE_QUOTA_BYTES=1073741824
MAX_ACTIVE_HEAVY_JOBS_PER_USER=2
IMPORTS_PER_HOUR=10
JOB_SOFT_TIMEOUT=300
JOB_HARD_TIMEOUT=600
INSTAGRAM_SYNC_SOFT_TIMEOUT=1200
INSTAGRAM_SYNC_HARD_TIMEOUT=1800
TRUSTED_PROXY_CIDRS=172.28.24.10/32
RELEASE_VERSION=local

# Additional V1 runtime configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
SESSION_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
ENCRYPTION_KEY_VERSION=1
TERMS_VERSION=2026-10-07
PRIVACY_VERSION=2026-10-07
CONNECTION_TERMS_VERSION=2026-10-07
MAX_ACTIVE_IMPORTS_PER_PROFILE=1
RAW_FILE_TTL_HOURS=24
IMPORT_CONFIRM_TTL_HOURS=24
EXPORT_TTL_HOURS=24
JOB_METADATA_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30
INSTAGRAM_LOGIN_MAX_ATTEMPTS=3
INSTAGRAM_LARGE_CHANGE_FRACTION=0.5
INSTAGRAM_LARGE_CHANGE_MIN_MEMBERS=100
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PWA=true
ENABLE_OFFICIAL_INSTAGRAM=false
METRICS_ENABLED=true
WORKER_CONCURRENCY=2
CELERY_BROKER_URL=redis://redis:6379/0
S3_USE_TLS=true
APP_NAME=InstaSurveillance
LOG_LEVEL=INFO

# Separate encrypted off-host PostgreSQL backups and optional operations alerts
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_FERNET_KEY
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_STATUS_DIRECTORY=/backup-status
ALERT_WEBHOOK_URL=

# Production network and resource limits
APP_NETWORK_CIDR=172.28.24.0/24
APP_EDGE_IP=172.28.24.10
MAX_HTTP_BODY_BYTES=105906176
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=1g
WORKER_CPU_LIMIT=1.5
AUTH_WORKER_MEMORY_LIMIT=512m
AUTH_WORKER_CPU_LIMIT=0.5
MAINTENANCE_MEMORY_LIMIT=256m
SCHEDULER_MEMORY_LIMIT=128m
FRONTEND_MEMORY_LIMIT=768m
DB_MEMORY_LIMIT=2g
DB_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=256m

ENCRYPTION_PREVIOUS_KEYS={}
JOB_STALE_SECONDS=120
ERROR_TRACKING_DSN=

CORS_ALLOWED_ORIGINS=

S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
STORAGE_WRITE_TIMEOUT_SECONDS=300

# Private shared application JSON logs; production retention is LOG_RETENTION_DAYS
LOG_DIRECTORY=/logs

BROKER_PUBLISH_TIMEOUT_SECONDS=3

# Logical bucket quota (0 means unbounded managed S3); cloud provider capacity monitoring is separate.
S3_STORAGE_QUOTA_BYTES=0

DB_CONNECT_TIMEOUT_SECONDS=3
VOLUME_METRICS_MEMORY_LIMIT=64m

# Optional private object-store capacity exporters; managed S3 uses provider monitoring.
STORAGE_METRICS_TARGET=
STORAGE_METRICS_TOKEN=
STORAGE_METRICS_SCHEME=https
BACKUP_METRICS_TARGET=
BACKUP_METRICS_TOKEN=
BACKUP_METRICS_SCHEME=https
